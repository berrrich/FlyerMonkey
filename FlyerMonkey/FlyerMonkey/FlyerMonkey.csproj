<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Opt in for standalone APKs; SDK Install deploys current assemblies on constrained emulators. -->
    <EmbedAssembliesIntoApk Condition="'$(FlyerMonkeyStandaloneAndroid)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
    <!-- Public registration ID approved for local Android customer testing. No credential. -->
    <FlyerMonkeyCustomerClientId Condition="'$(Configuration)' == 'Debug' and '$(FlyerMonkeyCustomerClientId)' == ''">dbc3555c-669f-423e-acf3-f1cef013ce69</FlyerMonkeyCustomerClientId>
    <FlyerMonkeyCustomerMsalScheme Condition="'$(Configuration)' == 'Debug' and '$(FlyerMonkeyCustomerMsalScheme)' == ''">msal$(FlyerMonkeyCustomerClientId)</FlyerMonkeyCustomerMsalScheme>
    <FlyerMonkeyCustomerTrustDirectory>$(MSBuildThisFileDirectory)..\..\.artifacts\mobile-customer-trust</FlyerMonkeyCustomerTrustDirectory>
    <FlyerMonkeyCustomerClientId Condition="'$(FlyerMonkeyCustomerClientId)' == ''"></FlyerMonkeyCustomerClientId>
    <FlyerMonkeyCustomerMsalScheme Condition="'$(FlyerMonkeyCustomerMsalScheme)' == ''">flyermonkey-customer-unconfigured</FlyerMonkeyCustomerMsalScheme>
    <FlyerMonkeyCustomerApiBaseUrl Condition="'$(FlyerMonkeyCustomerApiBaseUrl)' == ''">https://localhost:7255/</FlyerMonkeyCustomerApiBaseUrl>
    <FlyerMonkeyMsalScheme Condition="'$(FlyerMonkeyMsalScheme)' == ''">flyermonkey-unconfigured</FlyerMonkeyMsalScheme>
    <AndroidManifestPlaceholders>flyermonkeyMsalScheme=$(FlyerMonkeyMsalScheme);flyermonkeyCustomerMsalScheme=$(FlyerMonkeyCustomerMsalScheme)</AndroidManifestPlaceholders>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <!-- Note for MacCatalyst:
      The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
      When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
      The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
      either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

    <OutputType>Exe</OutputType>
    <RootNamespace>FlyerMonkey</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>FlyerMonkey</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.companyname.flyermonkey</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated public certificate and domain-scoped trust are local Debug inputs only. -->
    <AndroidResource Remove="Platforms\Android\Resources\xml\crater_debug_network_security_config.xml"
      Condition="'$(Configuration)' == 'Debug' and Exists('$(FlyerMonkeyCustomerTrustDirectory)\res\xml\crater_debug_network_security_config.xml')" />
    <AndroidResource Include="$(FlyerMonkeyCustomerTrustDirectory)\res\xml\crater_debug_network_security_config.xml"
      Link="Resources\xml\crater_debug_network_security_config.xml"
      Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and Exists('$(FlyerMonkeyCustomerTrustDirectory)\res\xml\crater_debug_network_security_config.xml')" />
    <AndroidResource Include="$(FlyerMonkeyCustomerTrustDirectory)\res\raw\mobile_customer_dev_ca.cer"
      Link="Resources\raw\mobile_customer_dev_ca.cer"
      Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and Exists('$(FlyerMonkeyCustomerTrustDirectory)\res\raw\mobile_customer_dev_ca.cer')" />
    <AssemblyMetadata Include="CustomerClientId" Value="$(FlyerMonkeyCustomerClientId)" />
    <AssemblyMetadata Include="CustomerRedirectScheme" Value="$(FlyerMonkeyCustomerMsalScheme)" />
    <AssemblyMetadata Include="CustomerApiBaseUrl" Value="$(FlyerMonkeyCustomerApiBaseUrl)" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.84.2" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <AndroidManifestOverlay Include="Platforms\Android\AndroidManifest.Debug.xml" Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <AndroidResource Remove="Platforms\Android\Resources\xml\crater_debug_network_security_config.xml" Condition="'$(Configuration)' != 'Debug'" />
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Remove="FlyerMonkey.Server\**" />
    <Compile Remove="FlyerMonkey.Server\**" />
    <Content Remove="FlyerMonkey.Server\**" />
    <EmbeddedResource Remove="FlyerMonkey.Server\**" />
    <MauiXaml Remove="FlyerMonkey.Server\**" />
    <None Remove="FlyerMonkey.Server\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Syncfusion.Blazor.SfPdfViewer" Version="32.2.4" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="32.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SQLServerConnection\SQLServerConnection.csproj" />
    <ProjectReference Include="..\FlyerMonkey.Shared\FlyerMonkey.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>

</Project>
