@using FlyerMonkey.Shared.Services
@inject IWebsiteCraterSession Session
@inject IServiceProvider Services

<section class="card card-body my-3" aria-labelledby="product-crater-title">
    <h2 id="product-crater-title">Crater It</h2>
    <p>Create something playful inspired by this product.</p>
    <form method="get" action="@ProductPath">
        <input type="hidden" name="crater" value="true" />
        <button type="submit" class="btn btn-outline-primary" aria-describedby="product-crater-context">☄️ Crater It</button>
    </form>
    <p id="product-crater-context" class="text-muted mt-2">Product ID: @ProductId</p>
    @if (Expanded)
    {
        <div role="status" class="mt-3">
            @if (_authenticated && _generation?.Enabled == true && Product is not null)
            {
                <p>LOCAL DEVELOPMENT generation. Each attempt uses the paid image API. Artwork stays private.</p>
                <label for="crater-prompt">Optional creative prompt</label>
                <input id="crater-prompt" class="form-control" maxlength="500" @bind="_prompt" disabled="@_state.Attempted"
                       placeholder="Send this product crashing through a supermarket aboard a comet." />
                <button type="button" class="btn btn-primary mt-2" @onclick="Generate" disabled="@_state.Attempted">Generate image</button>
                <p role="status">@_state.Status</p>
                @if (_state.Error is not null) { <p role="alert">@_state.Error</p> }
                @if (_state.Image is not null) { <img class="img-fluid" src="@_state.Image" alt="Playful AI artwork inspired by this product" /> }
            }
            else if (_authenticated)
            {
                <p>You are signed in as an operator. Generation is restricted and disabled here.
                    ViewOwn allows viewing your own artwork; it does not grant Generate permission.</p>
            }
            else
            {
                <p>You will need a customer account to use Crater It. Public customer sign-in is coming later.
                    For now, you can keep browsing products and offers.</p>
            }
            @if (!_authenticated || _generation?.Enabled != true || Product is null)
            {
                <button type="button" class="btn btn-secondary" disabled>Generation unavailable</button>
            }
            <p class="mt-2"><a href="@ProductPath">Back to this product</a> · <a href="/offers">Browse offers</a></p>
        </div>
    }
    else if (_authenticated && _generation?.Enabled != true)
    {
        <p class="mt-2">Operator access is restricted. Generation is disabled; ViewOwn does not grant Generate.</p>
    }
</section>

@code {
    [Parameter] public int ProductId { get; set; }
    [Parameter] public FlyerMonkey.Shared.Model.Product? Product { get; set; }
    [Parameter] public bool Expanded { get; set; }
    // Construct the only return destination ourselves. Never consume returnUrl or a browser-provided URI.
    private string ProductPath => $"/products/{ProductId.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
    private bool _authenticated;
    private ILocalDevelopmentGeneration? _generation;
    private LocalDevelopmentGenerationState _state = new();
    private string _prompt = "";
    private int _stateProductId;

    private Task Generate() => _authenticated && Product?.ID == ProductId && _generation is not null
        ? _state.GenerateAsync(_generation, Product, _prompt) : Task.CompletedTask;

    protected override async Task OnParametersSetAsync()
    {
        if (ProductId <= 0) throw new ArgumentOutOfRangeException(nameof(ProductId));
        _generation = Services.GetService(typeof(ILocalDevelopmentGeneration)) as ILocalDevelopmentGeneration;
        if (_stateProductId != ProductId) { _state = new(); _prompt = ""; _stateProductId = ProductId; }
        _authenticated = await Session.IsAuthenticatedAsync();
    }
}
