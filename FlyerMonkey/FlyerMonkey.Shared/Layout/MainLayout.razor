@inherits LayoutComponentBase

<div class="page">
 
    <main>
        <div class="fm-topbar">
            <div class="fm-topbar-brand">
                FlyerMonkey
            </div>

            <nav class="fm-topbar-nav">
                <NavLink href=""
                         Match="NavLinkMatch.All">
                    Offers
                </NavLink>

                <NavLink href="previous">
