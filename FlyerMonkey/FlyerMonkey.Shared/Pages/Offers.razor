@page "/"

@using FlyerMonkey.Shared.Model
@using FlyerMonkey.Shared.Services
@using FlyerMonkey.Shared.UI.Offers
@inject IOfferService OfferService

<div class="offers-heading">
    <h1 class="offers-title">This Week's Offers</h1>

    <button class="offer-refresh-button"
            @onclick="RefreshOffersAsync"
            title="Refresh offers">
        ↻
    </button>
</div>

<div class="offer-stats">
    @offersUI.Offers.Count offers
</div>

@if (offersUI.IsLoading)
{
    <p>Loading offers...</p>
}
else if (offersUI.LoadError is not null)
{
    <p class="text-danger">@offersUI.LoadError</p>
}
else if (offersUI.Offers.Count == 0)
{
    <p>No offers found.</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(offersUI.LoadError))
    {
        <div class="offer-error">
            <p>@offersUI.LoadError</p>

            <button class="offer-button"
                    @onclick="offersUI.LoadOffersAsync">
                Retry
            </button>
        </div>
    }
    <div class="offers-list">
        @foreach (var offer in offersUI.Offers)
        {
            <div class="offer-card">
                <div class="offer-thumb">
    @if (offer.ProductID > 0)
    {
        <img src="@($"https://flyermonkeyapi-g7htasdacxfzgbcd.australiaeast-01.azurewebsites.net/api/products/{offer.ProductID}/image")"
             alt="@offer.ProductName"
             loading="lazy"
             onerror="this.onerror=null;this.src='/_content/FlyerMonkey.Shared/images/product-placeholder.png';"
             style="width:80px;height:80px;object-fit:contain;border-radius:8px;" />

    }
    else
    {
        <img src="/_content/FlyerMonkey.Shared/images/product-placeholder.png"
             alt="Product image unavailable" loading="lazy"
             style="width:80px;height:80px;object-fit:contain;border-radius:8px;" />
    }
</div>

                <div class="offer-main">
                    <div class="offer-name">@offer.ProductName</div>

                    <div class="offer-meta">
                        @offer.RetailerName
                        @if (!string.IsNullOrWhiteSpace(offer.StoreName))
                        {
                            <span> · @offer.StoreName</span>
                        }
                    </div>

                    <div class="offer-meta">
                        @offer.PackSizeText
                        @if (!string.IsNullOrWhiteSpace(offer.Category))
                        {
                            <span> · @offer.Category</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(offer.UnitPriceText))
                    {
                        <div class="offer-meta">@offer.UnitPriceText</div>
                    }
                </div>

                <div class="offer-price-area">
                    @if (offer.AdvertisedPrice.HasValue)
                    {
                        <div class="offer-price">
                            @offer.AdvertisedPrice.Value.ToString("C")
                        </div>
                    }

                    <a class="offer-button"
                       href="@($"/offers/{offer.OfferID}")">
                        View
                    </a>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<OfferSummary> offers = new();
    private bool isLoading;
    private string? loadError;
    private OffersUI offersUI = null!;
    private int refreshCount;

    private async Task RefreshOffersAsync()
    {
        refreshCount++;
        await offersUI.LoadOffersAsync();

    }
    protected override async Task OnInitializedAsync()
    {
        offersUI = new OffersUI(OfferService);
        await offersUI.LoadOffersAsync();
    }
}
