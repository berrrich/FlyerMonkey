@page "/account"
@using FlyerMonkey.Shared.Components
@using FlyerMonkey.Shared.Services
@inject IServiceProvider Services
@inject NavigationManager Navigation

<h1>Account</h1>
@if (_session is { } session)
{
    <section class="card card-body my-3">
        @if (_busy)
        {
            <p role="status">Checking your customer session…</p>
        }
        else if (session.SignedIn)
        {
            <CustomerAccountSummary DisplayName="@session.DisplayName" Email="@session.Email" Account="@session.Account"
                                    CraterStatus="@session.CraterPreview?.Message" />
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-primary" @onclick="() => Run(() => session.LoadAccountAsync(ProductId))">Refresh status</button>
                <button class="btn btn-outline-secondary" @onclick="() => Run(session.SignOutAsync)">Sign out</button>
            </div>
        }
        else
        {
            <p>Sign in to check your Crater It access.</p>
            <div><button class="btn btn-primary" @onclick="() => SignIn(session)">Sign in</button></div>
        }
        @if (!_busy && session.Message is { } message)
        {
            <p class="mt-2 mb-0" role="status">@message</p>
        }
    </section>
}
else
{
    <p>Open Account from the navigation when customer sign-in is available.</p>
}
<p><a href="">Browse offers</a></p>
@if (ProductPath is { } productPath)
{
    <p><a href="@productPath">Back to Product @ProductId</a></p>
}

@code {
    [SupplyParameterFromQuery] public int? ProductId { get; set; }
    private IMobileCustomerSession? _session;
    private bool _busy;
    private string? ProductPath => ProductId is > 0 ? $"products/{ProductId}?crater=true" : null;

    protected override void OnInitialized() =>
        _session = Services.GetService(typeof(IMobileCustomerSession)) as IMobileCustomerSession;

    protected override Task OnParametersSetAsync() =>
        _session is { } session ? Run(() => session.LoadAccountAsync(ProductId)) : Task.CompletedTask;

    private Task SignIn(IMobileCustomerSession session) => Run(async () =>
    {
        await session.SignInAsync(includeCraterStatus: ProductPath is null);
        if (session.SignedIn && session.Account is not null && ProductPath is { } path)
            Navigation.NavigateTo(path);
    });

    private async Task Run(Func<Task> operation)
    {
        if (_busy) return;
        _busy = true;
        try { await operation(); }
        finally { _busy = false; }
    }
}
