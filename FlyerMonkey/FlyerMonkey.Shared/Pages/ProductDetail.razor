@page "/products/{Id:int}"

@using FlyerMonkey.Shared.Model
@using FlyerMonkey.Shared.Services
@using FlyerMonkey.Shared.Components

@inject IProductService ProductService
@inject ImageGenerationApiService ImageGeneration
@implements IDisposable

<PageTitle>Product Details</PageTitle>

@if (_product is null)
{
    <p>Loading product...</p>
}
else
{
    <div class="container py-4">

        <a href="/products" class="d-inline-block mb-4">
            ← Back to Products
        </a>

        <div class="fm-detail-layout">

            <section class="fm-artwork" aria-label="Product images">
                <figure>
                    <div class="fm-product-image">
                        @if (!string.IsNullOrWhiteSpace(_product.ImageBlobPath))
                        {
                            <img src="@($"https://flyermonkeyapi-g7htasdacxfzgbcd.australiaeast-01.azurewebsites.net/api/products/{_product.ID}/image")"
                                 alt="@_product.Name"
                                 onerror="this.onerror=null;this.src='/_content/FlyerMonkey.Shared/images/product-placeholder.png';" />
                        }
                        else
                        {
                            <img src="/_content/FlyerMonkey.Shared/images/product-placeholder.png"
                                 alt="Product image unavailable" />
                        }
                    </div>
                    <figcaption>Original product image — authoritative product reference when available.</figcaption>
                </figure>
                @if (_preview is not null)
                {
                    <figure>
                        <div class="fm-product-image">
                            <img src="@_preview" alt="@_previewStyle artwork inspired by @_product.Name" />
                        </div>
                        <figcaption>@_previewStyle — AI-generated artwork, not an authoritative product reference.</figcaption>
                        <button type="button" class="btn btn-link" @onclick="HideArtwork">Hide artwork</button>
                    </figure>
                }
            </section>
            <div class="fm-detail-information">

                <div class="fm-product-details">

                    <div class="text-muted mb-2">
                        @(_product.PrimaryCategory
                            ?? _product.Category
                            ?? "Uncategorised")
                    </div>

                    <h1>@_product.Name</h1>

                    @if (!string.IsNullOrWhiteSpace(_product.Brand))
                    {
                        <p>
                            <strong>Brand:</strong>
                            @_product.Brand
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(_product.PackSizeText))
                    {
                        <p>
                            <strong>Pack size:</strong>
                            @_product.PackSizeText
                        </p>
                    }

                    <h5 class="mt-4">Categories</h5>

                    @if (_product.Categories is { Count: > 0 })
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var category in _product.Categories)
                            {
                                <span class="badge bg-secondary">
                                    @category
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            No additional categories assigned.
                        </p>
                    }

                    <hr class="my-4" />

                    @if (ImageGeneration.IsEnabled)
                    {
                        <section id="crater-controls" aria-labelledby="crater-title" tabindex="-1" @ref="_craterControls">
                            <h2 id="crater-title">Crater It!</h2>
                            @if (_history.Count > 0)
                            {
                                <label for="crater-history">Saved artwork</label>
                                <select id="crater-history" class="form-select mb-2" value="@_selectedArtwork" @onchange="SelectArtworkAsync" disabled="@(_generation is not null)">
                                    <option value="">Choose saved artwork</option>
                                    @foreach (var artwork in _history)
                                    {
                                        <option value="@artwork.ArtworkId">@artwork.PresetName — @artwork.CreatedUtc.ToString("u")</option>
                                    }
                                </select>
                            }
                            <label for="crater-style">Creative style</label>
                            <select id="crater-style" class="form-select mb-2" @bind="_style" disabled="@(_generation is not null)">
                                @foreach (var preset in CraterItPromptBuilder.Presets)
                                {
                                    <option value="@preset.Style">@preset.Name</option>
                                }
                            </select>
                            <p>@CraterItPromptBuilder.GetPreset(_style).Description</p>
                            <p class="text-muted">Artwork is saved automatically. Packaging and branding may differ from the original.</p>
                            <button type="button" class="btn btn-outline-secondary w-100"
                                    disabled="@(_generation is not null)" @onclick="GenerateAsync">
                                <CraterComet /> @(_generation is not null ? "Cratering..." : "Crater It!")
                            </button>
                            @if (_generation is not null)
                            {
                                <p role="status">Generating and saving artwork...</p>
                                <button class="btn btn-link" @onclick="CancelGeneration">Cancel</button>
                            }
                            @if (_generationMessage is not null)
                            {
                                <p role="alert">@_generationMessage</p>
                            }
                        </section>
                    }
                    else
                    {
                        <p class="text-muted">Crater It! is available for local development testing only.</p>
                    }

                </div>
            </div>

        </div>

        <!-- Related offers -->
        <section class="mt-5">

            <h3>Compare Offers</h3>

            <p class="text-muted">
                Compare prices and promotions from retailers.
            </p>

            <div class="fm-offer-placeholder">
                Offers for this product will appear here.
            </div>

        </section>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "crater")]
    public bool OpenCrater { get; set; }

    private ElementReference _craterControls;
    private bool _focusCrater;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCrater && _product is not null && ImageGeneration.IsEnabled)
        {
            _focusCrater = false;
            await _craterControls.FocusAsync();
        }
    }

    private Product? _product;
    private CancellationTokenSource? _generation;
    private string? _preview;
    private string? _previewStyle;
    private CraterStyle _style = CraterStyle.Classic;
    private string? _generationMessage;
    private bool _disposed;
    private int _loadVersion;
    private List<CraterArtwork> _history = [];
    private string _selectedArtwork = "";
    private CancellationTokenSource? _retrieval;
    private (Guid Id, string Prompt, CraterStyle Style, string Name)? _pending;

    private void HideArtwork()
    {
        _retrieval?.Cancel();
        _selectedArtwork = "";
        _preview = null;
    }

    private async Task SelectArtworkAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id) && _history.FirstOrDefault(a => a.ArtworkId == id) is { } artwork)
            await ShowArtworkAsync(artwork);
        else HideArtwork();
    }

    private async Task ShowArtworkAsync(CraterArtwork artwork)
    {
        _retrieval?.Cancel();
        using var retrieval = new CancellationTokenSource();
        _retrieval = retrieval;
        var version = _loadVersion;
        try
        {
            var bytes = await ImageGeneration.ReadAsync(artwork.ArtworkId, retrieval.Token);
            if (!_disposed && version == _loadVersion && !retrieval.IsCancellationRequested)
            {
                _preview = "data:image/jpeg;base64," + Convert.ToBase64String(bytes);
                _previewStyle = artwork.PresetName;
                _selectedArtwork = artwork.ArtworkId.ToString();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            if (!_disposed && version == _loadVersion && !retrieval.IsCancellationRequested)
                _generationMessage = "Saved artwork could not be loaded. It may be missing or the local API may be unavailable.";
        }
        finally { if (ReferenceEquals(_retrieval, retrieval)) _retrieval = null; }
    }

    private async Task GenerateAsync()
    {
        if (_disposed || _generation is not null || _product is null || !ImageGeneration.IsEnabled)
            return;

        var productId = Id;
        var request = new CancellationTokenSource();
        _generation = request;
        _generationMessage = null;
        var style = _style;
        var prompt = CraterItPromptBuilder.Build(_product, style);
        _retrieval?.Cancel();
        if (_pending is not { } pending || pending.Prompt != prompt || pending.Style != style || pending.Name != _product.Name)
            _pending = (Guid.NewGuid(), prompt, style, _product.Name ?? "");
        try
        {
            var artwork = await ImageGeneration.GenerateAsync(_pending.Value.Id, productId,
                _pending.Value.Name, style, prompt, request.Token);
            if (IsCurrent() && !request.IsCancellationRequested)
            {
                _pending = null;
                _history = _history.Where(a => a.ArtworkId != artwork.ArtworkId).Prepend(artwork).ToList();
                await ShowArtworkAsync(artwork);
            }
        }
        catch (OperationCanceledException)
        {
            if (IsCurrent())
                _generationMessage = request.IsCancellationRequested
                    ? "Cancelled waiting. Artwork may still be saved; reload to check history. An accepted request may incur a charge."
                    : "Generation timed out. Reload to check history before retrying.";
        }
        catch (Exception)
        {
            if (IsCurrent())
                _generationMessage = "Generation or saving failed. Reload to check history before retrying. Check that the local API is running and enabled.";
        }
        finally
        {
            if (ReferenceEquals(_generation, request))
                _generation = null;
            request.Dispose();
        }

        bool IsCurrent() => !_disposed && Id == productId && ReferenceEquals(_generation, request);
    }

    private void CancelGeneration()
    {
        _generation?.Cancel();
        _retrieval?.Cancel();
    }

    public void Dispose()
    {
        _disposed = true;
        CancelGeneration();
    }

    protected override async Task OnParametersSetAsync()
    {
        CancelGeneration();
        _generation = null;
        _preview = null;
        _previewStyle = null;
        _style = CraterStyle.Classic;
        _focusCrater = OpenCrater;
        _generationMessage = null;
        _history = [];
        _selectedArtwork = "";
        _pending = null;
        var version = ++_loadVersion;
        var productId = Id;
        _product = null;

        var products = await ProductService.GetProductsAsync();

        if (!_disposed && version == _loadVersion)
        {
            _product = products.FirstOrDefault(p => p.ID == productId);
            if (_product is not null && ImageGeneration.IsEnabled)
            {
                using var retrieval = new CancellationTokenSource();
                _retrieval = retrieval;
                try
                {
                    var history = await ImageGeneration.ListAsync(productId, retrieval.Token);
                    if (!_disposed && version == _loadVersion && !retrieval.IsCancellationRequested)
                    {
                        _history = history;
                        if (history.FirstOrDefault() is { } newest) await ShowArtworkAsync(newest);
                    }
                }
                catch (OperationCanceledException) { }
                catch (Exception)
                {
                    if (!_disposed && version == _loadVersion)
                        _generationMessage = "Saved artwork history could not be loaded. Check the local API.";
                }
                finally { if (ReferenceEquals(_retrieval, retrieval)) _retrieval = null; }
            }
        }
    }
}
