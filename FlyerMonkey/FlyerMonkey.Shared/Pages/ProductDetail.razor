@page "/products/{Id:int}"

@using FlyerMonkey.Shared.Model
@using FlyerMonkey.Shared.Services
@using FlyerMonkey.Shared.Components

@inject IProductService ProductService
@inject ImageGenerationApiService ImageGeneration
@inject CraterArtworkApiService ArtworkGallery
@inject IServiceProvider Services
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable

<PageTitle>Product Details</PageTitle>

@if (_productLoadError is not null)
{
    <p role="alert">@_productLoadError</p>
    <button type="button" class="btn btn-outline-secondary" @onclick="LoadProductAsync">Retry</button>
    <a href="/products">Back to Products</a>
}
else if (_product is null)
{
    <p>Loading product...</p>
}
else
{
    <div class="container py-4 fm-detail-page @(CanGenerate ? "fm-has-comet" : "")">

        <a href="/products" class="d-inline-block mb-4">
            ← Back to Products
        </a>

        <div class="fm-detail-layout">

            <div class="fm-creative-column">
            <section class="fm-artwork" aria-label="Product images">
                <figure>
                    <div class="fm-product-image">
                        @if (!string.IsNullOrWhiteSpace(_product.ImageBlobPath))
                        {
                            <img src="@PublicApiClientRegistration.ProductImageUrl(_product.ID)"
                                 alt="@_product.Name"
                                 onerror="this.onerror=null;this.src='/_content/FlyerMonkey.Shared/images/product-placeholder.png';" />
                        }
                        else
                        {
                            <img src="/_content/FlyerMonkey.Shared/images/product-placeholder.png"
                                 alt="Product image unavailable" />
                        }
                    </div>
                    <figcaption>Original product image — authoritative product reference when available.</figcaption>
                </figure>
                <ApprovedArtworkDisplay ProductId="@_product.ID" ProductName="@_product.Name" />
                @if (_preview is not null)
                {
                    <figure>
                        <div class="fm-product-image">
                            <img @ref="_previewImage" src="@_preview" @onload="PreviewLoadedAsync" @onerror="PreviewFailed"
                                 alt="@_previewStyle artwork inspired by @_product.Name" />
                        </div>
                        <figcaption>@_previewStyle — AI-generated artwork, not an authoritative product reference.</figcaption>
                        <button type="button" class="btn btn-link" @onclick="HideArtwork">Hide artwork</button>
                    </figure>
                }
            </section>
                <div class="fm-creative-tools">
                    @if (IsWebsite)
                    {
                        <ProductCraterEntry ProductId="@_product.ID" Product="@_product" Expanded="@OpenCrater" />
                    }
                    else
                    {
                    @if (ArtworkGallery.IsEnabled)
                    {
                        <section aria-labelledby="crater-gallery-title">
                            <h2 id="crater-gallery-title">Saved Crater artwork</h2>
                            @if (_history.Count > 0)
                            {
                                <label for="crater-history">Saved artwork</label>
                                <select id="crater-history" class="form-select mb-2" value="@_selectedArtwork" @onchange="SelectArtworkAsync" disabled="@(_generation is not null)">
                                    <option value="">Choose saved artwork</option>
                                    @foreach (var artwork in _history)
                                    {
                                        <option value="@artwork.ArtworkId">@artwork.PresetName — @artwork.CreatedUtc.ToString("u")</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <p>@(_historyLoading ? "Loading saved artwork..." : "No saved artwork available for this product.")</p>
                            }
                            @if (_artworkMessage is not null)
                            {
                                <p role="alert">@_artworkMessage</p>
                            }
                        </section>
                    }
                    @if (CanGenerate)
                    {
                        <section id="crater-controls" aria-labelledby="crater-title" tabindex="-1" @ref="_craterControls">
                            <h2 id="crater-title">Crater It!</h2>
                            <label for="crater-style">Creative style</label>
                            <select id="crater-style" class="form-select mb-2" @bind="_style" disabled="@(_generation is not null)">
                                @foreach (var preset in CraterItPromptBuilder.Presets)
                                {
                                    <option value="@preset.Style">@preset.Name</option>
                                }
                            </select>
                            <p>@CraterItPromptBuilder.GetPreset(_style).Description</p>
                            <p class="text-muted">Artwork is saved automatically. Packaging and branding may differ from the original.</p>
                            <button type="button" class="btn btn-outline-secondary w-100"
                                    disabled="@(_generation is not null)" @onclick="GenerateAsync">
                                <CraterComet /> @(_generation is not null ? "Cratering..." : "Crater It!")
                            </button>
                            @if (_generation is not null)
                            {
                                <span class="fm-crater-working" aria-hidden="true"><CraterComet /></span>
                                <progress aria-label="Crater artwork progress"></progress>
                                <p role="status">@_progress — @_elapsed.ToString("F1") s elapsed</p>
                                <button class="btn btn-link" @onclick="CancelGeneration">Cancel</button>
                            }
                            @if (_timingSummary is not null)
                            {
                                <p role="status">@_timingSummary</p>
                            }
                            @if (_generationMessage is not null)
                            {
                                <p role="alert">@_generationMessage</p>
                            }
                        </section>
                    }
                    else if (ArtworkGallery.IsEnabled)
                    {
                        <p class="text-muted">Image generation is disabled on this device. You can view previously saved artwork.</p>
                    }
                    else
                    {
                        <p class="text-muted">Crater It! is available for local development testing only.</p>
                    }

                    }
                </div>
            </div>
            <div class="fm-detail-information">

                <div class="fm-product-details">

                    <div class="text-muted mb-2">
                        @(_product.PrimaryCategory
                            ?? _product.Category
                            ?? "Uncategorised")
                    </div>

                    <h1>@_product.Name</h1>

                    @if (!string.IsNullOrWhiteSpace(_product.Brand))
                    {
                        <p>
                            <strong>Brand:</strong>
                            @_product.Brand
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(_product.PackSizeText))
                    {
                        <p>
                            <strong>Pack size:</strong>
                            @_product.PackSizeText
                        </p>
                    }

                    <h5 class="mt-4">Categories</h5>

                    @if (_product.Categories is { Count: > 0 })
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var category in _product.Categories)
                            {
                                <span class="badge bg-secondary">
                                    @category
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            No additional categories assigned.
                        </p>
                    }

                </div>
            </div>

        </div>

        <!-- Related offers -->
        <section class="mt-5">

            <h3>Compare Offers</h3>

            <p class="text-muted">
                Compare prices and promotions from retailers.
            </p>

            <div class="fm-offer-placeholder">
                Offers for this product will appear here.
            </div>

        </section>

    </div>
    @if (CanGenerate)
    {
        <button type="button" class="fm-floating-comet" aria-label="Fancy inventing a picture?"
                aria-haspopup="dialog" aria-controls="crater-invitation" @ref="_floatingComet" @onclick="OpenInvitationAsync">
            <span aria-hidden="true"><CraterComet /></span>
        </button>
        <dialog id="crater-invitation" class="fm-crater-invitation" aria-labelledby="crater-invitation-title"
                aria-describedby="crater-invitation-description" @ref="_invitation">
            <h2 id="crater-invitation-title">Fancy inventing a picture?</h2>
            <p id="crater-invitation-description">We can create a completely new, wonderfully ridiculous image inspired by this product. It usually takes less than a minute.</p>
            <div class="fm-invitation-actions">
                <button type="button" class="btn btn-primary" @onclick="AcceptInvitationAsync">Yes, ☄️ Crater it now!</button>
                <button type="button" class="btn btn-outline-secondary" autofocus @onclick="DismissInvitationAsync">No thanks, not right now</button>
            </div>
        </dialog>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "crater")]
    public bool OpenCrater { get; set; }

    private bool IsWebsite => Services.GetService(typeof(IWebsiteCraterSession)) is not null;
    private bool CanGenerate => !IsWebsite && ImageGeneration.IsEnabled;

    private ElementReference _craterControls;
    private ElementReference _floatingComet;
    private ElementReference _invitation;

    private Task OpenInvitationAsync() => InvitationAsync("openInvitation", _invitation, _floatingComet, _craterControls);
    private Task AcceptInvitationAsync() => InvitationAsync("closeInvitation", _invitation, true);
    private Task DismissInvitationAsync() => InvitationAsync("closeInvitation", _invitation, false);

    private async Task InvitationAsync(string action, params object?[] arguments)
    {
        if (_disposed || _product is null || !CanGenerate) return;
        var version = _loadVersion;
        try
        {
            await using var module = await Microsoft.JSInterop.JSRuntimeExtensions.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                JS, "import", "./_content/FlyerMonkey.Shared/craterInvitation.js");
            if (!_disposed && version == _loadVersion)
                await Microsoft.JSInterop.JSObjectReferenceExtensions.InvokeVoidAsync(module, action, arguments);
        }
        catch (Microsoft.JSInterop.JSException) { }
        catch (OperationCanceledException) { }
    }
    private bool _focusCrater;
    private ElementReference _previewImage;
    private System.Diagnostics.Stopwatch? _clock;
    private double _elapsed;
    private string _progress = "Generating and saving artwork";
    private string? _timingSummary;
    private TaskCompletionSource<bool>? _displayed;

    private async Task PreviewLoadedAsync()
    {
        var displayed = _displayed;
        if (displayed is null) return;
        var version = _loadVersion;
        var preview = _preview;
        try
        {
            await using var module = await Microsoft.JSInterop.JSRuntimeExtensions.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                JS, "import", "./_content/FlyerMonkey.Shared/craterTiming.js");
            if (!IsCurrent()) return;
            await Microsoft.JSInterop.JSObjectReferenceExtensions.InvokeVoidAsync(module, "afterPaint", _previewImage);
            if (!IsCurrent()) return;
            displayed.TrySetResult(true);
            // Revealing is a convenience; a scroll failure must not fail a displayed image.
            try
            {
                await Microsoft.JSInterop.JSObjectReferenceExtensions.InvokeVoidAsync(module, "reveal", _previewImage, preview);
            }
            catch (Exception) { }
        }
        catch (Exception) { displayed.TrySetResult(false); }

        bool IsCurrent() => !_disposed && version == _loadVersion &&
            ReferenceEquals(displayed, _displayed) && _generation is { IsCancellationRequested: false } && _preview == preview;
    }

    private void PreviewFailed() => _displayed?.TrySetResult(false);

    private async Task UpdateElapsedAsync(System.Diagnostics.Stopwatch clock, CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
            while (await timer.WaitForNextTickAsync(token))
                await InvokeAsync(() => { if (!_disposed && ReferenceEquals(_clock, clock)) { _elapsed = clock.Elapsed.TotalSeconds; StateHasChanged(); } });
        }
        catch (OperationCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCrater && _product is not null && CanGenerate)
        {
            _focusCrater = false;
            await _craterControls.FocusAsync();
        }
    }

    private Product? _product;
    private string? _productLoadError;
    private CancellationTokenSource? _generation;
    private string? _preview;
    private string? _previewStyle;
    private CraterStyle _style = CraterStyle.Classic;
    private string? _generationMessage;
    private string? _artworkMessage;
    private bool _historyLoading;
    private bool _disposed;
    private int _loadVersion;
    private List<CraterArtwork> _history = [];
    private string _selectedArtwork = "";
    private CancellationTokenSource? _retrieval;
    private (Guid Id, string Prompt, CraterStyle Style, string Name)? _pending;

    private void HideArtwork()
    {
        _retrieval?.Cancel();
        _selectedArtwork = "";
        _preview = null;
    }

    private async Task SelectArtworkAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id) && _history.FirstOrDefault(a => a.ArtworkId == id) is { } artwork)
            await ShowArtworkAsync(artwork);
        else HideArtwork();
    }

    private async Task ShowArtworkAsync(CraterArtwork artwork)
    {
        _retrieval?.Cancel();
        using var retrieval = new CancellationTokenSource();
        _retrieval = retrieval;
        var version = _loadVersion;
        try
        {
            _artworkMessage = null;
            var bytes = await ArtworkGallery.ReadAsync(artwork.ArtworkId, retrieval.Token);
            if (!_disposed && version == _loadVersion && !retrieval.IsCancellationRequested)
            {
                _preview = "data:image/jpeg;base64," + Convert.ToBase64String(bytes);
                _previewStyle = artwork.PresetName;
                _selectedArtwork = artwork.ArtworkId.ToString();
            }
        }
        catch (OperationCanceledException)
        {
            if (!_disposed && version == _loadVersion && !retrieval.IsCancellationRequested)
                _artworkMessage = "Saved artwork download timed out. Reload history to try again.";
        }
        catch (Exception)
        {
            if (!_disposed && version == _loadVersion && !retrieval.IsCancellationRequested)
                _artworkMessage = "Saved artwork could not be loaded. It may be missing or the local API may be unavailable.";
        }
        finally { if (ReferenceEquals(_retrieval, retrieval)) _retrieval = null; }
    }

    private async Task GenerateAsync()
    {
        if (_disposed || _generation is not null || _product is null || !CanGenerate)
            return;

        var productId = Id;
        var clock = System.Diagnostics.Stopwatch.StartNew();
        _clock = clock;
        _elapsed = 0;
        _timingSummary = null;
        _progress = "Generating and saving artwork";
        var request = new CancellationTokenSource();
        using var ticking = new CancellationTokenSource();
        var ticker = UpdateElapsedAsync(clock, ticking.Token);
        _generation = request;
        _generationMessage = null;
        _preview = null;
        _selectedArtwork = "";
        var style = _style;
        var prompt = CraterItPromptBuilder.Build(_product, style);
        _retrieval?.Cancel();
        if (_pending is not { } pending || pending.Prompt != prompt || pending.Style != style || pending.Name != _product.Name)
            _pending = (Guid.NewGuid(), prompt, style, _product.Name ?? "");
        try
        {
            var result = await ImageGeneration.GenerateTimedAsync(_pending.Value.Id, productId,
                _pending.Value.Name, style, prompt, request.Token);
            var artwork = result.Artwork;
            if (IsCurrent() && !request.IsCancellationRequested)
            {
                _pending = null;
                _history = _history.Where(a => a.ArtworkId != artwork.ArtworkId).Prepend(artwork).ToList();
                _progress = "Artwork saved; loading image";
                var displayed = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
                _displayed = displayed;
                await ShowArtworkAsync(artwork);
                if (!IsCurrent() || request.IsCancellationRequested) return;
                if (_selectedArtwork != artwork.ArtworkId.ToString())
                    throw new InvalidOperationException("Saved image download failed.");
                StateHasChanged();
                var visible = await displayed.Task.WaitAsync(TimeSpan.FromSeconds(15), request.Token);
                if (!visible) throw new InvalidOperationException("Image display failed.");
                if (!IsCurrent()) return;
                clock.Stop();
                _elapsed = clock.Elapsed.TotalSeconds;
                var outcome = result.Outcome switch { "fresh" => "Fresh generation", "replay" => "Saved-request replay (no new generation)", _ => "Saved artwork (server timing unavailable)" };
                _timingSummary = $"{outcome}. Tap to image display: {_elapsed:F1} s. Server generation: {Seconds(result.GenerationMs)}; save: {Seconds(result.SaveMs)}. Request {artwork.RequestId}.";
            }
        }
        catch (OperationCanceledException)
        {
            if (IsCurrent())
                _generationMessage = request.IsCancellationRequested
                    ? "Cancelled waiting. Artwork may still be saved; reload to check history. An accepted request may incur a charge."
                    : "Generation timed out. Reload to check history before retrying.";
        }
        catch (TimeoutException)
        {
            if (IsCurrent()) _generationMessage = "Artwork was saved, but image display was not confirmed. Reload saved history before generating again.";
        }
        catch (HttpRequestException ex)
        {
            if (IsCurrent()) _generationMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.TooManyRequests => "The local API is busy. Wait for the current operation to finish; check history before retrying.",
                System.Net.HttpStatusCode.NotFound => "Generation is unavailable. Check Development mode, CraterIt enablement, port 5145 and ADB reverse.",
                _ => "The local API request failed. Check connectivity and API logs; reload saved history before retrying."
            };
        }
        catch (Exception)
        {
            if (IsCurrent())
                _generationMessage = "Generation, saving or image display failed. Reload saved history before retrying. Check the local API and ADB forwarding.";
        }
        finally
        {
            ticking.Cancel();
            await ticker;
            clock.Stop();
            if (ReferenceEquals(_generation, request))
            {
                _displayed = null;
                _generation = null;
            }
            request.Dispose();
        }

        bool IsCurrent() => !_disposed && Id == productId && ReferenceEquals(_generation, request);
        static string Seconds(double? ms) => ms is { } value ? $"{value / 1000:F2} s" : "unavailable";
    }

    private void CancelGeneration()
    {
        _generation?.Cancel();
        _retrieval?.Cancel();
    }

    public void Dispose()
    {
        _disposed = true;
        CancelGeneration();
    }

    protected override Task OnParametersSetAsync() => LoadProductAsync();

    private async Task LoadProductAsync()
    {
        CancelGeneration();
        _generation = null;
        _displayed = null;
        _clock = null;
        _timingSummary = null;
        _preview = null;
        _previewStyle = null;
        _style = CraterStyle.Classic;
        _focusCrater = OpenCrater;
        _generationMessage = null;
        _history = [];
        _artworkMessage = null;
        _historyLoading = false;
        _selectedArtwork = "";
        _pending = null;
        var version = ++_loadVersion;
        var productId = Id;
        _product = null;
        _productLoadError = null;

        List<Product> products;
        try { products = await ProductService.GetProductsAsync(); }
        catch (Exception)
        {
            if (!_disposed && version == _loadVersion)
                _productLoadError = "This product could not be loaded. Check your connection and try again.";
            return;
        }

        if (!_disposed && version == _loadVersion)
        {
            _product = products.FirstOrDefault(p => p.ID == productId);
            if (_product is null) _productLoadError = "Product not found.";
            if (_product is not null && !IsWebsite && ArtworkGallery.IsEnabled)
            {
                _historyLoading = true;
                using var retrieval = new CancellationTokenSource();
                _retrieval = retrieval;
                try
                {
                    var history = await ArtworkGallery.ListAsync(productId, retrieval.Token);
                    if (!_disposed && version == _loadVersion && !retrieval.IsCancellationRequested)
                    {
                        _history = history;
                        if (history.FirstOrDefault() is { } newest) await ShowArtworkAsync(newest);
                    }
                }
                catch (OperationCanceledException) { }
                catch (Exception)
                {
                    if (!_disposed && version == _loadVersion)
                        _artworkMessage = "Saved artwork history could not be loaded. Check the local API and ADB forwarding.";
                }
                finally
                {
                    if (version == _loadVersion) _historyLoading = false;
                    if (ReferenceEquals(_retrieval, retrieval)) _retrieval = null;
                }
            }
        }
    }
}
