@page "/splitPDF"

<PageTitle>Split PDF</PageTitle>

<h1>Split PDF</h1>

<p role="status">Current count: @currentCount</p>


@code {
    private int currentCount = 0;
    //<button class="btn btn-primary" @onclick="location.href='@Url.Action("SplitPDFFiles","Home")'">Split PDF</button>
    private void IncrementCount()
    {
        currentCount++;
    }
}
