@page "/products"

@using FlyerMonkey.Shared.Model
@using FlyerMonkey.Shared.Services
@inject IProductService ProductService

<h1 class="offers-title">Offers</h1>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (loadError is not null)
{
    <p class="text-danger">@loadError</p>
}
else if (products?.Any() != true)
{
    <p>No offers found.</p>
}
else
{
    <div class="offers-list">
        @foreach (var p in products)
        {
            <div class="offer-card">
                <div class="offer-thumb">
                    🛒
                </div>

                <div class="offer-main">
                    <div class="offer-name">@p.Name</div>

                    @if (!string.IsNullOrWhiteSpace(p.Brand))
                    {
                        <div class="offer-meta">@p.Brand</div>
                    }

                    <div class="offer-meta">
                        @p.PackSizeText
                        @if (!string.IsNullOrWhiteSpace(p.Category))
                        {
                            <span> · @p.Category</span>
                        }
                    </div>
                </div>

                <button class="offer-button">
                    View
                </button>
            </div>
        }
    </div>
}

@code {
    private List<Product> products = new();
    private bool isLoading;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            products = await ProductService.GetProductsAsync();
        }
        catch (Exception ex)
        {
            loadError = "Failed to load offers: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}