@page "/products"
@using FlyerMonkey.Shared.Model
@using FlyerMonkey.Shared.Services

@inject IProductService ProductService

<PageTitle>Products</PageTitle>

<h1>Products</h1>

@if (_products is null)
{
    <p>Loading...</p>
}
else if (_products.Count == 0)
{
    <p>No products found.</p>
}
else
{
    <table class="table">
        <thead>
    <tr>
        <th>Image</th>
        <th>ID</th>
        <th>Name</th>
    </tr>
</thead>
        <tbody>
            @foreach (var product in _products)
            {
                <tr>
    <td>
        @if (!string.IsNullOrWhiteSpace(product.ImageBlobPath))
        {
            <img src="@($"https://flyermonkeyapi-g7htasdacxfzgbcd.australiaeast-01.azurewebsites.net/api/products/{product.ID}/image")"
                 alt="@product.Name"
                 style="width:80px;height:80px;object-fit:contain;border-radius:8px;"
                 loading="lazy" />
        }
    </td>
    <td>@product.ID</td>
    <td>@product.Name</td>
</tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? _products;

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetProductsAsync();
    }
}