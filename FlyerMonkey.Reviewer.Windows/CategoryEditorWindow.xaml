<Window x:Class="FlyerMonkey.Reviewer.Windows.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlyerMonkey - Edit Categories"
        Width="420"
        Height="540"
        MinWidth="350"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F7F7F7">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Product heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="EDIT PRODUCT CATEGORIES"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="ProductNameText"
                       FontSize="14"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Primary category -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="Primary category"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="PrimaryCategoryCombo"
                      Height="34"
                      DisplayMemberPath="Name"/>
        </StackPanel>

        <!-- Additional categories -->
        <GroupBox Grid.Row="2"
                  Header="Additional categories (optional)"
                  Padding="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AdditionalCategoriesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="Cancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button Content="Save Categories"
                    Width="140"
                    Height="36"
                    IsDefault="True"
                    Click="SaveCategories_Click"/>
        </StackPanel>
    </Grid>
</Window>