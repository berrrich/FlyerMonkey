<Window x:Class="FlyerMonkey.Reviewer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flyer Monkey Reviewer"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F3F3">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <!-- Flyers -->
            <ColumnDefinition Width="240"/>
            <!-- Pages -->
            <ColumnDefinition Width="300"/>
            <!-- Extracted Products -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
            <!-- Saved -->
            <!-- Big page preview -->
        </Grid.ColumnDefinitions>

        <!-- Left flyer column -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <Border DockPanel.Dock="Top"
                        Padding="16"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1">

                    <TextBlock Text="FLYERS"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </Border>

                <ListBox x:Name="FlyerList"
                         Margin="10"
                         BorderThickness="0"
                         Background="Transparent"                         
                         SelectionChanged="FlyerList_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="0,0,0,10"
                                    Padding="12"
                                    BorderBrush="#D8D8D8"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="White">

                                <StackPanel>

                                    <TextBlock Text="{Binding Retailer}"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding FlyerDate}"
                                               Margin="0,4,0,0"
                                               Foreground="#555555"/>

                                    <TextBlock Text="{Binding PageDescription}"
                                               Margin="0,3,0,0"
                                               Foreground="#777777"/>

                                    <TextBlock Text="{Binding FileName}"
                                               Margin="0,8,0,0"
                                               FontSize="11"
                                               Foreground="#999999"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>

        </Border>

        <!-- Selected flyer column pages -->
        <Border Grid.Column="1"
        Background="White"
        BorderBrush="#D0D0D0"
        BorderThickness="0,0,1,0">

            <DockPanel>

                <Border DockPanel.Dock="Top"
                Padding="16"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">

                    <TextBlock Text="PAGES"
                       FontSize="18"
                       FontWeight="SemiBold"/>
                </Border>

                <ListBox x:Name="PageList"
                 Margin="10"
                 BorderThickness="0"
                 Background="Transparent"                         
         SelectionChanged="PageList_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="0,0,0,8"
                            Padding="12"
                            BorderBrush="#D8D8D8"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White">

                                <StackPanel>

                                    <Border Width="160"
            Height="200"
            Margin="0,0,0,10"
            Background="#F2F2F2"
            BorderBrush="#DDDDDD"
            BorderThickness="1">

                                        <Image Source="{Binding Thumbnail}"
               Stretch="Uniform"/>
                                    </Border>

                                    <TextBlock Text="{Binding DisplayName}"
               FontSize="16"
               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding FileName}"
               Margin="0,5,0,0"
               FontSize="11"
               Foreground="#999999"
               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>

        </Border>
        <!-- Extracted product data -->
        <Border Grid.Column="2"
        Background="White"
        BorderBrush="#D0D0D0"
        BorderThickness="0,0,1,0"
        Padding="10">

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,10,0,0">

                    <Button x:Name="SaveDataButton"
            Content="Save"
            Width="120"
            Height="38"
            Margin="5"
            Click="SaveDataButton_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top"
                   Text="EXTRACTED PRODUCTS"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="5,5,5,15"/>

                <ListBox x:Name="ProductList"
         BorderThickness="0"
         Background="Transparent"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,8">

                                <StackPanel>

                                    <TextBlock Text="{Binding ProductName}"
                               FontWeight="Bold"
                               FontSize="16"
                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Price}"
                               FontSize="18"/>

                                    <TextBlock Text="{Binding UnitPrice}"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Promotion}"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>
        </Border>

        <!-- Page preview -->
        <Border Grid.Column="3"
        Margin="10"
        Padding="15"
        BorderBrush="#DDD"
        BorderThickness="1"
        CornerRadius="8">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                   Text="PAGE REVIEW"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

                <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

                    <Button x:Name="SplitFlyerButton"
                    Content="Split Flyer"
                    Width="140"
                    Height="42"
                    Margin="5"
                    Click="SplitFlyerButton_Click"/>

                    <Button x:Name="GetDataButton"
                    Content="Get Data"
                    Width="140"
                    Height="42"
                    Margin="5"
                    Visibility="Collapsed"
                    Click="GetDataButton_Click"/>

                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                    <Grid>

                        <Image x:Name="SelectedPageImage"
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Top"
               Margin="10"
               Visibility="Collapsed"/>

                    </Grid>

                </ScrollViewer>

            </DockPanel>
        </Border>
        <!-- Saved Extraction Runs -->
        <Border Grid.Column="4"
        Background="White"
        BorderBrush="#D0D0D0"
        BorderThickness="1,0,0,0">

            <DockPanel>

                <!-- Commit button stays at bottom -->
                <StackPanel DockPanel.Dock="Bottom"
                    Margin="10">

                    <Button x:Name="CommitButton"
                    Content="Commit"
                    Height="38"
                    Click="CommitButton_Click"/>
                </StackPanel>

                <!-- Heading -->
                <TextBlock DockPanel.Dock="Top"
                   Text="LOCALLY SAVED"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="15"/>

                <!-- SQLite contents -->
                <ListBox x:Name="SavedExtractionList"
                 Margin="10,0,10,10"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,0,0,8">

                                <StackPanel>

                                    <TextBlock Text="{Binding Retailer}"
                                       FontWeight="Bold"
                                       FontSize="15"/>

                                    <TextBlock Text="{Binding PageFileName}"
                                       Margin="0,3,0,0"/>

                                    <TextBlock Text="{Binding ProductCount, StringFormat={}{0} products}"
                                       Foreground="Gray"/>

                                    <TextBlock Text="{Binding SavedAt}"
                                       FontSize="11"
                                       Foreground="#999999"
                                       Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SavedUtc}"
           FontSize="11"
           Foreground="#999999"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>
        </Border>

    </Grid>
</Window>