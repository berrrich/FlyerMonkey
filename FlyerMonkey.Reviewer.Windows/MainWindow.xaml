<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlyerMonkey.Reviewer.Windows" x:Class="FlyerMonkey.Reviewer.Windows.MainWindow" Title="Flyer Monkey Reviewer" Height="800" Width="1400" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Shared extraction status colours -->
        <SolidColorBrush x:Key="SavedStatusBrush" Color="#70B8F0"/>
        <SolidColorBrush x:Key="CommittedStatusBrush" Color="#8BD49B"/>
        <SolidColorBrush x:Key="CommittedBorderBrush" Color="#54AD69"/>
    </Window.Resources>
    <Grid Background="#F3F3F3" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FlyerColumn" Width="300"/>
            <ColumnDefinition x:Name="PagesColumn" Width="240"/>
            <ColumnDefinition x:Name="ProductColumn" Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="SavedColumn" Width="230"/>
            <!-- Saved -->
        </Grid.ColumnDefinitions>
        <!-- Left flyer column -->
        <Border Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FLYERS" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="↻" FontFamily="Segoe UI Symbol" FontSize="20" Width="32" Height="32" Padding="0" ToolTip="Refresh flyers" Click="RefreshFlyers_Click"/>
                    </Grid>
                </Border>
                <ListBox x:Name="FlyerList" Margin="10" BorderThickness="0" Background="Transparent" SelectionChanged="FlyerList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="6" Background="White">
                                <StackPanel>
                                    <TextBlock Text="{Binding Retailer}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FlyerDate}" Margin="0,4,0,0" Foreground="#555555"/>
                                    <TextBlock Text="{Binding PageDescription}" Margin="0,3,0,0" Foreground="#777777"/>
                                    <TextBlock Text="{Binding FileName}" Margin="0,8,0,0" FontSize="11" Foreground="#000" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <!-- Selected flyer column pages -->
        <Border Grid.Column="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <TextBlock Text="PAGES" FontSize="18" FontWeight="SemiBold"/>
                </Border>
                <ListBox x:Name="PageList" Margin="10" BorderThickness="0" Background="Transparent" SelectionChanged="PageList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExtractionStatus}" Value="Saved">
                                                <Setter Property="Background" Value="{StaticResource SavedStatusBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ExtractionStatus}" Value="Committed">
                                                <Setter Property="Background" Value="{StaticResource CommittedStatusBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Border Width="160" Height="200" Margin="0,0,0,10" Background="#F2F2F2" BorderBrush="#DDDDDD" BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FileName}" Margin="0,5,0,0" FontSize="11" Foreground="#000" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <!-- Extracted product data -->
        <Border Grid.Column="2" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="SaveDataButton" Content="Save" Width="120" Height="38" Margin="5" Click="SaveDataButton_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Padding="16" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EXTRACTED OFFERS" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="AddOfferButton" Grid.Column="1" Content="➕" Width="32" Height="32" ToolTip="Add offer" Click="AddOfferButton_Click"/>
                </Grid>
                </Border>
                <StackPanel DockPanel.Dock="Top" Margin="10,4">
                    <TextBlock x:Name="EditingContextText" TextWrapping="Wrap" Foreground="#8A4100" FontSize="11"/>
                    <Border x:Name="StatusSpace" Padding="5" Margin="0,4,0,0" CornerRadius="3">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EFF3F7"/><Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Background" Value="#FFF1BE"/></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Success"><Setter Property="Background" Value="#E5F3E6"/></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Failure"><Setter Property="Background" Value="#FCE5E5"/></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter Property="Background" Value="#FFF1D9"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Timing}" FontSize="10" Margin="4,0,0,0"/>
                                <ProgressBar DockPanel.Dock="Left" Width="20" Height="6" IsIndeterminate="True" Margin="0,0,5,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock FontSize="11" TextWrapping="Wrap" MaxHeight="42" ToolTip="{Binding Summary}"><Run Text="{Binding State, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Summary, Mode=OneWay}"/></TextBlock>
                            <DockPanel Margin="0,3,0,0"><TextBlock Text="Recent activity" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox ItemsSource="{Binding Recent}" Height="22" FontSize="10" HorizontalContentAlignment="Stretch" ToolTip="Recent completed operations"/></DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ListBox x:Name="ProductList" ScrollViewer.CanContentScroll="False"
PreviewMouseWheel="ProductList_PreviewMouseWheel" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>

                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DCEBFF"/>
                                    <Setter Property="BorderBrush" Value="#3478D4"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" Padding="10" Margin="0,0,0,8" ToolTip="{Binding Error}">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#DDD"/><Style.Triggers><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="BorderBrush" Value="#C62828"/><Setter Property="Background" Value="#FFF3F3"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="ProductNameDisplay" ToolTip="&#x270E; Click to edit product name" Text="{Binding ProductName}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding [ProductName]}" Value=""><Setter Property="Background" Value="Transparent"/></DataTrigger><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="ToolTip" Value="{Binding [ProductName]}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <Button Content="🗑" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Delete offer" Tag="{Binding}" Click="DeleteOfferButton_Click"/>
                                        <TextBox x:Name="ProductNameEditor" Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                    </Grid>
                                    <Border Background="#F2F2F2" Padding="6" Margin="0,8,0,8">
                                        <Grid Margin="0,8,0,8" Background="#ededed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Product / offer fields. Click a value to edit it. -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Brand:"/>
                                            <Grid Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="BrandDisplay" Text="{Binding Brand}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"/>
                                                <TextBox x:Name="BrandEditor" Text="{Binding Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Price:"/>
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="PriceDisplay" Text="{Binding Price}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding [Price]}" Value=""><Setter Property="Background" Value="Transparent"/></DataTrigger><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="ToolTip" Value="{Binding [Price]}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                <TextBox x:Name="PriceEditor" Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Reg.:"/>
                                            <Grid Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="RegularPriceDisplay" Text="{Binding RegularPrice}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"/>
                                                <TextBox x:Name="RegularPriceEditor" Text="{Binding RegularPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <!-- Derived value: display only. -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Calc. Reg.:"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CalculatedRegularPrice}" TextWrapping="Wrap" FontWeight="Bold" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Saving:"/>
                                            <Grid Grid.Row="4" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="SavingDisplay" Text="{Binding Saving}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"/>
                                                <TextBox x:Name="SavingEditor" Text="{Binding Saving, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Per Unit:"/>
                                            <Grid Grid.Row="5" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="UnitPriceDisplay" Text="{Binding UnitPrice}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"/>
                                                <TextBox x:Name="UnitPriceEditor" Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Variant:"/>
                                            <Grid Grid.Row="6" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="VariantDisplay" Text="{Binding Variant}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"/>
                                                <TextBox x:Name="VariantEditor" Text="{Binding Variant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Pck Size:"/>
                                            <Grid Grid.Row="7" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="PackSizeDisplay" Text="{Binding PackSizeText}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"/>
                                                <TextBox x:Name="PackSizeEditor" Text="{Binding PackSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Category:"/>
                                            <Grid Grid.Row="8" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="CategoryDisplay" Text="{Binding Category}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="CategoryDisplay_Click"/>
                                                <TextBox x:Name="CategoryEditor" Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Offer Qty:"/>
                                            <Grid Grid.Row="9" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock x:Name="OfferQuantityDisplay" Text="{Binding OfferQuantity}" TextWrapping="Wrap" FontWeight="Bold" Cursor="Hand" MouseLeftButtonUp="EditableField_Click"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding [OfferQuantity]}" Value=""><Setter Property="Background" Value="Transparent"/></DataTrigger><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="ToolTip" Value="{Binding [OfferQuantity]}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                <TextBox x:Name="OfferQuantityEditor" Text="{Binding OfferQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Visibility="Collapsed" LostFocus="EditableField_LostFocus" KeyDown="EditableField_KeyDown"/>
                                            </Grid>
                                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Promotion:"/>

                                            <Grid Grid.Row="10" Grid.Column="1" Margin="8,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0">
                                                    <TextBlock x:Name="PromotionDisplay"
                   Text="{Binding Promotion}"
                   TextWrapping="Wrap"
                   FontWeight="Bold"
                   Cursor="Hand"
                   MouseLeftButtonUp="EditableField_Click"/>

                                                    <TextBox x:Name="PromotionEditor"
                 Text="{Binding Promotion, Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 Visibility="Collapsed"
                 LostFocus="EditableField_LostFocus"
                 KeyDown="EditableField_KeyDown"/>
                                                </Grid>

                                                <Button Grid.Column="1"
            Content="Types"
            Width="52"
            Height="26"
            Margin="6,0,0,0"
            VerticalAlignment="Top"
            ToolTip="Edit promotion classifications"
            Tag="{Binding}"
            Click="PromotionTypes_Click"/>
                                            </Grid>

                                            <!-- Selected promotion classifications -->
                                            <TextBlock Grid.Row="11"
           Grid.Column="0"
           Text="Types:"/>

                                            <TextBlock Grid.Row="11"
           Grid.Column="1"
           Margin="8,0,0,0"
           Text="{Binding PromotionTypesDisplay}"
           TextWrapping="Wrap"
           FontWeight="Bold"
           Foreground="#3478D4"/>


                                        </Grid>
                                    </Border>
                                    <TextBlock Text="ⓘ Existing product" FontWeight="Bold" Margin="0,6,0,8" Foreground="Blue">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PossibleDuplicate}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button x:Name="CraterItButton" Content="{Binding ImageActionText}" IsEnabled="{Binding CanCrater}" Width="140" Height="42" Margin="5" Tag="{Binding}" Click="CraterItButton_Click"/>
                                    <TextBlock Text="{Binding CraterStatus}" TextWrapping="Wrap" Margin="5,0"/>
                                    <Button Content="Cancel image" Tag="{Binding}" Click="CancelCrater_Click" Margin="5" Padding="8,4">
                                        <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCraterGenerating}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                    <Button Content="Edit Image" Tag="{Binding}" Click="EditImage_Click" IsEnabled="{Binding HasImage}" Margin="5" Padding="8,6"/>
                                    <Button Content="Remove / Archive" Tag="{Binding}" Click="RemoveImage_Click" IsEnabled="{Binding HasImage}" Margin="5" Padding="8,6" ToolTip="Clear this offer image reference. The product, offer and image file are kept."/>
                                    <local:ProductThumbnail Source="{Binding ImageFilePath}" HorizontalAlignment="Center" Stretch="Uniform" Margin="5" Cursor="Hand" MouseLeftButtonUp="ProductImage_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <!-- Generated product image -->
        <!-- Page preview -->
        <Border Grid.Column="3" Margin="10" Padding="15" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PAGE REVIEW" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                <StackPanel x:Name="PageActions" DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <Button x:Name="CancelProcessingButton" Content="Cancel extraction" IsEnabled="False" Height="38" Margin="0,0,0,6" Click="CancelProcessing_Click" ToolTip="Cancel local image generation or extraction. Provider processing may already have occurred. Save, Split and Commit cannot be cancelled."/>
                    <Button x:Name="SplitFlyerButton" Content="Split Flyer" Height="38" Margin="0,0,0,6" Click="SplitFlyerButton_Click"/>
                    <Button x:Name="GetDataButton" Content="Get Data" Height="38" Visibility="Collapsed" Click="GetDataButton_Click"/>
                </StackPanel>
                <Grid>
                    <local:PdfPageReview x:Name="SelectedPageReview"/>
                </Grid>
            </DockPanel>
        </Border>
        <!-- Saved Extraction Runs -->
        <Border Grid.Column="4" Background="White" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- Commit button stays at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10">
                    <Button x:Name="CommitButton" Content="Commit" Height="38" IsEnabled="False" Click="CommitButton_Click"/>
                </StackPanel>
                <!-- Heading -->
                <TextBlock DockPanel.Dock="Top" Text="SAVED EXTRACTIONS" FontSize="18" FontWeight="SemiBold" Margin="15"/>
                <!-- SQLite contents -->
                <ListBox x:Name="SavedExtractionList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" SelectionMode="Single" SelectionChanged="SavedExtractionList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SavedStatusBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Committed">
                                                <Setter Property="Background" Value="{StaticResource CommittedStatusBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource CommittedBorderBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RecoveryRequired}" Value="True">
                                                <Setter Property="Background" Value="#FFF3CD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Retailer}" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{Binding PageFileName}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding StatusDisplay}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip="{Binding RecoveryExplanation}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecoveryRequired}" Value="True">
                                                        <Setter Property="Foreground" Value="#8A4100"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ProductCount,                                      StringFormat={}{0} products}" Foreground="Black"/>
                                    <TextBlock Text="{Binding SavedUtc}" FontSize="11" Foreground="#000" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
