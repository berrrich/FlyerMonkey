<Window x:Class="FlyerMonkey.Reviewer.Windows.PromotionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlyerMonkey - Edit Promotion Types"
        Width="420"
        Height="610"
        MinWidth="350"
        MinHeight="400"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Background="#F7F7F7">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Product and original promotion -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="EDIT PROMOTION TYPES"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="ProductNameText"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Original promotion:"
                       Margin="0,12,0,4"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="OriginalPromotionText"
                       TextWrapping="Wrap"
                       Foreground="#444444"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Select all applicable promotion types:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <!-- Promotion classifications -->
        <GroupBox Grid.Row="2"
                  Header="Promotion types"
                  Padding="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PromotionTypesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,7"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="Cancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button Content="Save Types"
                    Width="140"
                    Height="36"
                    IsDefault="True"
                    Click="SavePromotionTypes_Click"/>
        </StackPanel>
    </Grid>
</Window>
