<Window x:Class="FlyerMonkey.Reviewer.Windows.ClassicImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classic Crater It - Review Image" Width="900" Height="700" MinWidth="620" MinHeight="550" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="ProductHeading" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,8,0"><TextBlock DockPanel.Dock="Top" Text="Current image (kept until acceptance)" Margin="0,0,0,6"/><Border BorderBrush="#CCC" BorderThickness="1"><Image x:Name="OriginalImage" Stretch="Uniform" Margin="8"/></Border></DockPanel>
            <DockPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock DockPanel.Dock="Top" Text="Proposed image" Margin="0,0,0,6"/><Border BorderBrush="#CCC" BorderThickness="1"><Image x:Name="ProposedImage" Stretch="Uniform" Margin="8"/></Border></DockPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Optional instructions for this image"/><TextBox x:Name="Instructions" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/></StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Generate a proposal, then accept it to replace the current image. Generation uses the configured paid provider." TextWrapping="Wrap" Margin="0,10,0,10"/>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button x:Name="GenerateButton" Content="Generate Proposal" Click="Generate_Click" Padding="12,8" Margin="0,0,8,0"/>
            <Button x:Name="CancelGenerationButton" Content="Cancel Generation" IsEnabled="False" Click="CancelGeneration_Click" Padding="12,8" Margin="0,0,8,0"/>
            <Button x:Name="AcceptButton" Content="Accept Image" IsEnabled="False" Click="Accept_Click" Padding="12,8" Margin="0,0,8,0"/>
            <Button x:Name="RejectButton" Content="Reject / Keep Current" Click="Reject_Click" Padding="12,8"/>
        </WrapPanel>
    </Grid>
</Window>
